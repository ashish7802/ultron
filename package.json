{
  "name": "ultron-desktop",
  "productName": "ULTRON",
  "version": "1.0.0",
  "description": "ULTRON - Standalone desktop AI assistant with 3D holographic orb, voice chat, and hand gesture tracking",
  "main": "electron/main.js",
  "author": "ULTRON",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 127.0.0.1",
    "build:next": "next build",
    "build:electron": "electron-builder --dir",
    "build": "npm run build:next && npm run build:electron",
    "start": "electron .",
    "lint": "eslint .",
    "test": "npm run test:core",
    "test:lite": "tsx scripts/test_browser_assistant.mjs && tsx scripts/test_briefing_explorer.mjs",
    "test:core": "tsx scripts/test_milestone5_battery.cjs && tsx scripts/test_phase2_battery.cjs && tsx scripts/test_final_security_invariants.cjs && tsx scripts/test_browser_assistant.mjs && tsx scripts/test_briefing_explorer.mjs",
    "test:chat": "node scripts/verify_chat_regressions.mjs",
    "test:ollama": "node scripts/verify_chat_regressions.mjs",
    "test:research": "python tests_quantum_research.py",
    "test:memory": "tsx scripts/test_phase2_battery.cjs",
    "test:security": "tsx scripts/test_final_security_invariants.cjs",
    "test:desktop": "tsx scripts/test_milestone5_battery.cjs",
    "test:gamedev": "tsx scripts/test_gamedev_battery.cjs",
    "package": "electron-builder",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@tailwindcss/postcss": "^4.3.5",
    "lucide-react": "^1.75.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.5",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0"
  },
  "build": {
    "appId": "com.ultron.desktop",
    "productName": "ULTRON",
    "copyright": "Copyright © 2026 ULTRON",
    "directories": {
      "buildResources": "build/icons",
      "output": "release"
    },
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static"
      },
      {
        "from": "public",
        "to": "standalone/public"
      },
      {
        "from": "ultron_engine",
        "to": "standalone/ultron_engine",
        "filter": [
          "**/*.py"
        ]
      }
    ],
    "files": [
      "electron/**/*",
      "app/**/*",
      "lib/**/*",
      "components/**/*",
      "package.json",
      "next.config.ts",
      "tsconfig.json"
    ]
  }
}
